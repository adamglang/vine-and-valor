---
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import social from "@/config/social.json";
import DynamicIcon from "@/helpers/DynamicIcon";
import { markdownify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";

const { copyright, footer_description, contact_email, contact_phone, contact_phone_tel, license_text, address } = config.params;

const { footer } = menu;
---

<footer class="py-16 lg:py-20 bg-primary text-text-light">
  <div class="container">
    <div class="row max-lg:g-8">
      <div class="col-12 lg:col-6 min-h-full">
        <div class="flex flex-col justify-between h-full gap-8">
          <div>
            <Image
              src={config.site.footer_logo}
              width={360}
              height={85}
              alt="Vine & Valor Solutions"
              class="mb-6 max-w-[300px] sm:max-w-[360px] w-full h-auto"
            />

            <p
              class="text-base-sm text-text-light/90 mb-6 max-w-md"
              set:html={markdownify(footer_description)}
            />

            <ul class="space-y-3 text-base-sm">
              <li class="flex items-start gap-3">
                <DynamicIcon icon="FaLocationDot" className="mt-1 shrink-0" />
                <span>Based in {address} · Serving the Idaho Panhandle</span>
              </li>
              <li class="flex items-center gap-3">
                <DynamicIcon icon="FaPhone" className="shrink-0" />
                <a href={`tel:${contact_phone_tel}`} class="hover:underline">{contact_phone}</a>
              </li>
              <li class="flex items-center gap-3">
                <DynamicIcon icon="FaEnvelope" className="shrink-0" />
                <a href={`mailto:${contact_email}`} class="hover:underline break-all">{contact_email}</a>
              </li>
              <li class="flex items-center gap-3">
                <DynamicIcon icon="FaShieldHalved" className="shrink-0" />
                <span>{license_text}</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
      <div class="col-12 lg:col-6">
        <div class="row max-md:gy-6 justify-between">
          {
            footer.map((menu, index) => (
              <div class="col-12 sm:col-6 md:col-5 pr-0">
                <p class="mb-5 max-sm:mt-5 font-secondary uppercase tracking-wide text-text-light text-base">
                  {menu.title}
                </p>
                <ul>
                  {menu.children.map((child) => (
                    <li class="mb-3 last:mb-0 text-text-light/90 text-base-sm hover:text-secondary hover:underline transition-all duration-300 ease-in-out">
                      <a href={child.url}>{child.name}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
          {
            social.main.length > 0 && (
              <div class="col-12 sm:col-6 md:col-2 pr-0">
                <p class="mb-5 max-sm:mt-5 font-secondary uppercase tracking-wide text-text-light text-base">
                  Social
                </p>
                <ul class="flex flex-wrap gap-3">
                  {social.main.map((s) => (
                    <li>
                      <a
                        href={s.link}
                        target="_blank"
                        rel="noopener"
                        aria-label={s.name}
                        class="h-9 w-9 inline-flex items-center justify-center rounded-full bg-text-light/10 hover:bg-text-light/20 transition-colors">
                        <DynamicIcon icon={s.icon} className="text-text-light text-sm" />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
      </div>
    </div>
    <div class="mt-12 pt-6 border-t border-text-light/20">
      <p
        class="text-base-sm text-text-light/90 [&>a]:text-text-light [&>a]:underline"
        set:html={markdownify(copyright)}
      />
    </div>
  </div>
</footer>
