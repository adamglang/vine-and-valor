---
import { markdownify } from "@/lib/utils/textConverter";
import type { CollectionEntry } from "astro:content";
import CustomHeading from "../CustomHeading.astro";
import ImageMod from "../ImageMod.astro";

type Props = {
  responsibility: CollectionEntry<"homepage">["data"]["responsibility"];
};

const { responsibility } = Astro.props;
---

<section class="section-sm pt-0">
  <div class="container">
    <div class="max-w-3xl mb-12">
      <p
        set:html={markdownify(responsibility.subtitle)}
        class="mb-4 text-primary text-base-sm uppercase tracking-wide"
        data-aos="fade-up-sm"
      />

      <CustomHeading
        as="h2"
        text={responsibility.title}
        class="text-h3 md:text-h2-sm mb-6 text-balance"
        dataAos="fade-up-sm"
        dataAosDelay="20"
      />
      <p
        set:html={markdownify(responsibility.content)}
        class="text-text/80 text-balance"
        data-aos="fade-up-sm"
        data-aos-delay="40"
      />
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch">
      <ImageMod
        src={responsibility.image}
        alt="responsibility"
        width={720}
        height={540}
        class="w-full h-full aspect-[4/3] object-cover rounded-lg"
        data_aos="fade-up-sm"
        data_aos_delay="60"
      />
      <div
        class="bg-primary rounded-lg flex flex-col justify-center gap-7 p-8 lg:p-12">
        {
          responsibility.job.map((job, i) => (
            <div data-aos="fade-up-sm" data-aos-delay={80 + i * 20}>
              <h6
                set:html={markdownify(job.title)}
                class="text-text-light mb-2 font-secondary tracking-wide"
              />
              <p
                set:html={markdownify(job.content)}
                class="text-base-sm text-text-light/90"
              />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
