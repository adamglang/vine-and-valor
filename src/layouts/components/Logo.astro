---
import config from "@/config/config.json";
import ImageMod from "./ImageMod.astro";

const { src }: { src?: string } = Astro.props;
const {
  logo,
  logo_width,
  logo_height,
  logo_text,
}: {
  logo: string;
  logo_width: any;
  logo_height: any;
  logo_text: string;
} = config.site;

const w = parseInt(String(logo_width).replace("px", ""), 10);
const h = parseInt(String(logo_height).replace("px", ""), 10);
---

<a
  href="/"
  class="navbar-brand inline-flex items-center"
  aria-label={`${logo_text} go to homepage`}>
  {
    (src || logo) && (
      <ImageMod
        src={src ? src : logo}
        class="inline-block object-contain h-auto"
        width={w * 2}
        height={h * 2}
        alt={`${logo_text} logo`}
        style={{
          maxHeight: h + "px",
          maxWidth: w + "px",
        }}
        loading={"eager"}
        format="webp"
      />
    )
  }
</a>
