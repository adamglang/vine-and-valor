---
import config from "@/config/config.json";
import theme from "@/config/theme.json";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import "@/styles/main.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import "aos/dist/aos.css";
import "swiper/css";
import {
  GoogleTagmanager,
  GoogleTagmanagerNoscript,
} from "@digi4care/astro-google-tagmanager";

// font families - extract font names for Font component (filter out type keys)
const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type"),
);
export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
}
// destructure frontmatter
const { title, meta_title, description, image, noindex, canonical } =
  Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- google tag manager -->
    {
      config.google_tag_manager.enable && (
        <GoogleTagmanager id={config.google_tag_manager.gtm_id} />
      )
    }

    <!-- favicon -->
    <link rel="shortcut icon" href={config.site.favicon} />
    <!-- theme meta -->
    <meta name="theme-name" content="vine-and-valor" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#000"
    />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    <!-- google font css - Astro 6 built-in Font API -->
    {
      fontEntries.map(([key]) => {
        const cssVar = `--font-${key}` as any;
        return <Font cssVariable={cssVar} preload />;
      })
    }

    <!-- responsive meta -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <!-- title -->
    <title>
      {plainify(meta_title ? meta_title : title ? title : config.site.title)}
    </title>

    <!-- canonical url -->
    {canonical && <link rel="canonical" href={canonical} item-prop="url" />}

    <!-- noindex robots -->
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- meta-description -->
    <meta
      name="description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />

    <ClientRouter />

    <!-- author from config.json -->
    <meta name="author" content={config.metadata.meta_author} />

    <!-- og-title -->
    <meta
      property="og:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />

    <!-- og-description -->
    <meta
      property="og:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />
    <meta property="og:type" content="website" />
    <meta
      property="og:url"
      content={`${config.site.base_url.replace(/\/$/, "")}${Astro.url.pathname}`}
    />

    <!-- twitter-title -->
    <meta
      name="twitter:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />

    <!-- twitter-description -->
    <meta
      name="twitter:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />

    <!-- og-image -->
    <meta
      property="og:image"
      content={`${config.site.base_url.replace(/\/$/, "")}${image ? image : config.metadata.meta_image}`}
    />

    <!-- twitter-image -->
    <meta
      name="twitter:image"
      content={`${config.site.base_url.replace(/\/$/, "")}${image ? image : config.metadata.meta_image}`}
    />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- LocalBusiness / GeneralContractor structured data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "GeneralContractor",
        name: "Vine & Valor Solutions",
        image: `${config.site.base_url.replace(/\/$/, "")}${config.metadata.meta_image}`,
        logo: `${config.site.base_url.replace(/\/$/, "")}${config.site.logo}`,
        url: config.site.base_url,
        telephone: "+1-208-304-3525",
        email: "info@vineandvalorsolutions.com",
        priceRange: "$$",
        address: {
          "@type": "PostalAddress",
          addressLocality: "Priest River",
          addressRegion: "ID",
          addressCountry: "US",
        },
        areaServed: [
          "Priest River, Idaho",
          "Sandpoint, Idaho",
          "Priest Lake, Idaho",
          "Coeur d'Alene, Idaho",
          "Post Falls, Idaho",
          "Blanchard, Idaho",
          "Spirit Lake, Idaho",
          "Hayden, Idaho",
          "Bonners Ferry, Idaho",
        ],
        serviceArea: {
          "@type": "AdministrativeArea",
          name: "North Idaho (Idaho Panhandle)",
        },
        hasCredential: "Idaho Licensed Concrete Contractor",
        openingHoursSpecification: [
          {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
            opens: "08:00",
            closes: "16:00",
          },
        ],
        sameAs: [],
        makesOffer: [
          { "@type": "Offer", itemOffered: { "@type": "Service", name: "Concrete Foundations & Footings" } },
          { "@type": "Offer", itemOffered: { "@type": "Service", name: "Concrete Flatwork, Driveways & Patios" } },
          { "@type": "Offer", itemOffered: { "@type": "Service", name: "Stamped & Decorative Concrete" } },
          { "@type": "Offer", itemOffered: { "@type": "Service", name: "Retaining Walls & Structural Concrete" } },
          { "@type": "Offer", itemOffered: { "@type": "Service", name: "Excavation & Site Preparation" } },
          { "@type": "Offer", itemOffered: { "@type": "Service", name: "Fire Pits & Landscape Concrete" } },
          { "@type": "Offer", itemOffered: { "@type": "Service", name: "Concrete Repair & Restoration" } },
          { "@type": "Offer", itemOffered: { "@type": "Service", name: "Specialty Concrete & Sealing" } },
        ],
      })}
    />
  </head>
  <body>
    {/* google tag manager noscript */}
    {
      config.google_tag_manager.enable && (
        <GoogleTagmanagerNoscript id={config.google_tag_manager.gtm_id} />
      )
    }

    <Header />
    <main id="main-content">
      <slot />
    </main>
    <script>
      import config from "@/config/config.json";
      const sticky_header = config.settings.sticky_header;
      const stickyNavInit = () => {
        if (!sticky_header) return;
        const cta = document.getElementById("header-cta");
        const nav = document.getElementById("main-nav");
        if (!cta || !nav) return;

        let ticking = false;
        const update = () => {
          ticking = false;
          const threshold = cta.offsetHeight;
          if (window.scrollY >= threshold) {
            nav.classList.add("is-stuck");
          } else {
            nav.classList.remove("is-stuck");
          }
        };
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(update);
        };
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", update);
        update();
      };

      // aos
      import AOS from "aos";
      function aosInit() {
        AOS.init({
          duration: 600,
          once: true,
        });
      }

      aosInit();
      document.addEventListener("astro:after-swap", aosInit);

      document.addEventListener("astro:page-load", () => {
        stickyNavInit();
      });
    </script>
    <Footer />
  </body>
</html>
